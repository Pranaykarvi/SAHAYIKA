# Runtime Postgres connection — MUST be the RLS-constrained app role
# (sahayika_app), never the table owner, or row-level security is bypassed.
# Set the role's password once with: ALTER ROLE sahayika_app LOGIN PASSWORD '...'
DATABASE_URL=postgresql://sahayika_app:your-app-password@db.your-project.supabase.co:5432/postgres

# Owner/superuser connection used only by drizzle-kit (db:generate, db:migrate)
ADMIN_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase project URL; used only to verify auth tokens (JWKS), never for data
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (publishable) key; used only to verify auth tokens
SUPABASE_ANON_KEY=your-anon-key

# Expected `aud` claim on Supabase JWTs (default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated

# Origin allowed by CORS with credentials — the running frontend
FRONTEND_ORIGIN=http://localhost:3000

# Port the API listens on
PORT=4000

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Extraction provider id; valid ids live in src/lib/ai/providers/index.ts
AI_EXTRACTION_PROVIDER=

# API key for the chosen extraction provider
AI_EXTRACTION_API_KEY=

# Model id override for extraction (provider default applies if empty)
AI_EXTRACTION_MODEL=

# Embedding provider id; valid ids live in src/lib/ai/providers/index.ts
AI_EMBEDDING_PROVIDER=

# API key for the chosen embedding provider
AI_EMBEDDING_API_KEY=

# Model id override for embeddings (provider default applies if empty)
AI_EMBEDDING_MODEL=

# Deadline for every AI provider call in milliseconds; calls fail closed past it
AI_PROVIDER_TIMEOUT_MS=30000
