{
  "name": "sahayika-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sahayika API — owns all data and business logic, returns JSON only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
